{
    "version": 6,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "默认（Ninja + PATH 上的 g++）",
            "description": "编译器写死为 PATH 上的 g++，不含任何绝对路径；换机器只要 g++ 在 PATH 上就一致",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "g++"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        }
    ]
}
