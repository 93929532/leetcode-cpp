{
    "version": 6,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "默认（Ninja + PATH 上的 g++）",
            "description": "不含任何绝对路径；编译器与构建工具都从 PATH 自动探测",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        }
    ]
}
